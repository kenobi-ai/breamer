{
  "name": "breamer",
  "private": true,
  "description": "Cloudflare Workers + Containers browser service for Puppeteer-compatible CDP sessions",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.10",
    "puppeteer": "^24.9.0",
    "ws": "^8.18.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/containers": "^0.3.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.5.13",
    "knip": "^6.16.1",
    "pokayoke": "^0.0.5",
    "typescript": "^5.8.3",
    "wrangler": "^4.99.0"
  },
  "scripts": {
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "capture:mhtml": "bun scripts/capture-mhtml.ts",
    "compare:rendering": "bun scripts/compare-rendering.ts",
    "dev": "wrangler dev",
    "deploy": "bun run check && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "knip": "knip",
    "pokayoke": "pokayoke check",
    "typecheck": "bun run typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "typegen": "WRANGLER_WRITE_LOGS=false wrangler types",
    "check": "bun run typecheck && bun test && bun run biome && bun run knip && bun run pokayoke"
  }
}
